# CatPilot — variables d'environnement
# Copiez ce fichier en `.env.local` et remplissez les valeurs.
# NE COMMITTEZ JAMAIS `.env.local` (déjà ignoré par git).

# ----- Supabase (M2) -----
# Public (exposées côté client — sans danger) :
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Privée (serveur uniquement — JAMAIS côté client). Utilisée par les webhooks
# Stripe (M3) pour écrire le statut d'abonnement en contournant la RLS.
SUPABASE_SERVICE_ROLE_KEY=

