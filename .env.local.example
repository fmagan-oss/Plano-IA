# CatPilot — variables d'environnement
# Copiez ce fichier en `.env.local` et remplissez les valeurs.
# NE COMMITTEZ JAMAIS `.env.local` (déjà ignoré par git).

# ----- Site -----
# URL publique du site (pour robots.txt / sitemap.xml). Ex. https://catpilot.app
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ----- Supabase (M2) -----
# Publiques (exposées côté client — sans danger) :
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Privée (serveur uniquement — JAMAIS côté client). Utilisée par le webhook
# Stripe pour écrire le statut d'abonnement en contournant la RLS.
SUPABASE_SERVICE_ROLE_KEY=

# ----- Stripe (M3) -----
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
# IDs des prix créés dans le dashboard Stripe (mode abonnement, HT) :
STRIPE_PRICE_PRO_MONTHLY=price_...
STRIPE_PRICE_PRO_YEARLY=price_...

# ----- Anthropic (M5) -----
ANTHROPIC_API_KEY=sk-ant-...
# Optionnel — modèle par défaut : claude-opus-4-8
# ANTHROPIC_MODEL=claude-opus-4-8

# ----- Développement (optionnel) -----
# Force l'accès Pro en local sans abonnement Stripe (aperçu des fonctionnalités).
# Laisser vide en production.
# NEXT_PUBLIC_DEV_FORCE_PRO=1
